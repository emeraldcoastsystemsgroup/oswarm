# Generated by install/docker/install.sh in an installation directory; never in the repo.
.env
runtime.env
postgres.env
installation.json
.catalog-stage*
install/docker/applications/

# Terraform working files and state: state holds the installation's secrets.
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
*.auto.tfvars
*.auto.tfvars.json
crash.log

# Operator identifier list for scripts/publish-gate.sh (one regex per line). Never tracked.
scripts/publish-gate.local.patterns

# Editors and OS
.DS_Store
*.swp
.idea/
.vscode/
