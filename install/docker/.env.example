# oswarm Docker Compose settings. install.sh writes .env from this file; edit .env, not this one.
# Every value here is public configuration. Secrets live in runtime.env and postgres.env,
# which install.sh generates with mode 0600 and never prints.

# The published server image, pinned by tag and digest. The installer pulls it and checks its
# architecture and source revision. Advanced installations can supply their own image with
# OSWARM_IMAGE / --image.
OSWARM_IMAGE=ghcr.io/emeraldcoastsystemsgroup/oswarm:0.7.1@sha256:1731a07d146774cb764a839cabf2dde20136d68c8fb67f292dbc9ecadf4febc4

# Compose project name; one installation per name.
OSWARM_PROJECT=oswarm

# Where the kernel listens on this machine. Keep 127.0.0.1 unless a reverse proxy in front of
# it terminates TLS; the kernel itself speaks plain HTTP.
OSWARM_BIND_ADDRESS=127.0.0.1
OSWARM_PORT=38788

# The URL people open. Set it to the public https URL when a reverse proxy is in front.
OSWARM_PUBLIC_URL=http://127.0.0.1:38788

# Deployment profile the kernel runs with: home, team or enterprise (demo is for throwaway
# installations). It changes defaults, not features.
OSWARM_DEPLOYMENT=home

# Default inference provider for the fleet. `noop` answers nothing and costs nothing; add a
# real connection in the kernel's Connections screen after signing in.
OSWARM_FLEET_PROVIDER=noop
OSWARM_FLEET_MODEL=noop-1

# Resource ceilings for the two containers.
OSWARM_KERNEL_CPUS=2
OSWARM_KERNEL_MEMORY=2g
OSWARM_POSTGRES_MEMORY=512m

# AppArmor profile for the kernel container (Linux hosts with AppArmor). The installer loads
# `oshal-bwrap`; hosts without AppArmor ignore this.
OSWARM_APPARMOR_PROFILE=oshal-bwrap
